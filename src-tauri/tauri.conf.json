{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Genji Ball Host Tool",
  "mainBinaryName": "genjiball-host-tool",
  "version": "../package.json",
  "identifier": "us.genjiball.hosttool",
  "build": {
    "beforeDevCommand": "npm run vite:dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run vite:build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Genji Ball Host Tool",
        "width": 720,
        "height": 640,
        "minWidth": 480,
        "minHeight": 360
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ3QTFBNTZERjU1ODJFNkEKUldScUxsajFiYVdoMXk2SXZCeWtPZUZ2R21pZmV4TTB4eUlybFBETHovSVlQb2dUQXc4WEl5TWsK",
      "endpoints": [
        "https://github.com/Genji-Ball-Team/genjiball-host-tool/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "publisher": "Genji Ball Team",
    "homepage": "https://genjiball.us",
    "shortDescription": "Uploads Genji Ball ranked matches",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
